{
  "name": "falai-site",
  "packageManager": "bun@1.4.4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run metadata && vite",
    "build": "bun run metadata && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && bun scripts/prerender.ts",
    "metadata": "bun scripts/metadata.ts",
    "sync": "bun update @falai/agent --latest && bun run metadata",
    "lint": "oxlint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "bun run build && bunx wrangler pages deploy dist --project-name=falai-site --branch=main"
  },
  "dependencies": {
    "@falai/agent": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-shiki": "^0.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}